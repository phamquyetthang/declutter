#!/usr/bin/env bash
#
# declutter — reclaim disk space on a dev machine (Ubuntu + macOS), with a focus
# on the junk AI tools leave behind.
# https://github.com/quytstudio/declutter
#
# Default behaviour: scan, show a checkbox list, pre-tick the safe items.
# Nothing is deleted until you press Enter.

set -o pipefail

# ── find the install directory (following symlinks, e.g. /usr/local/bin) ─────
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
DECLUTTER_ROOT="$(cd -P "$(dirname "$_src")" && pwd)"
export DECLUTTER_ROOT

for _lib in core i18n registry actions ui report runner projects; do
  # shellcheck disable=SC1090
  . "$DECLUTTER_ROOT/lib/$_lib.sh" || { echo "missing lib/$_lib.sh" >&2; exit 1; }
done

# ── defaults ────────────────────────────────────────────────────────────────
LEVEL=green; ASSUME_YES=0; DEEP=0; PROJECTS_ONLY=0; DRY_RUN=0
USE_SUDO=auto; QUIET=0; ONLY=""; SKIP=""; PROJ_DAYS=60; TOP=15
INTERACTIVE=auto; SCAN_ROOT="$HOME"; JSON=0
LOG="${DECLUTTER_LOG:-$HOME/.declutter.log}"

# --lang has to win over $LANG, so scan for it before anything prints.
_prev=""
for _a in "$@"; do
  case "$_prev" in --lang) DECLUTTER_LANG="$_a" ;; esac
  _prev="$_a"
done
i18n_detect
i18n_load

while [ $# -gt 0 ]; do
  case "$1" in
    -l|--level)  LEVEL="$2"; shift ;;
    -y|--yes)    ASSUME_YES=1 ;;
    -n|--dry-run) DRY_RUN=1 ;;
    --report)    INTERACTIVE=no ;;
    --json)      JSON=1; INTERACTIVE=no; QUIET=1 ;;
    --only)      ONLY="$2"; shift ;;
    --skip)      SKIP="$2"; shift ;;
    --deep)      DEEP=1 ;;
    --projects)  PROJECTS_ONLY=1
                 case "${2:-}" in -*|"") ;; *) SCAN_ROOT="$2"; shift ;; esac ;;
    --days)      PROJ_DAYS="$2"; shift ;;
    --top)       TOP="$2"; shift ;;
    --sudo)      USE_SUDO="$2"; shift ;;
    --log)       LOG="$2"; shift ;;
    --lang)      shift ;;              # already applied above
    -q|--quiet)  QUIET=1 ;;
    -V|--version) echo "declutter $DECLUTTER_VERSION"; exit 0 ;;
    -h|--help)   usage; exit 0 ;;
    # shellcheck disable=SC2059
    *) printf "$T_ERR_UNKNOWN_OPT" "$1" >&2; exit 2 ;;
  esac
  shift
done

case "$LEVEL" in
  green|yellow) ;;
  red) die "$T_ERR_LEVEL_RED" ;;
  *)   die "$T_ERR_LEVEL" ;;
esac

validate_groups "$ONLY"
validate_groups "$SKIP"

# shellcheck disable=SC2059
[ "$PLATFORM" = other ] && die "$(printf "$T_ERR_PLATFORM" "$OS_NAME")"
setup_sudo

if [ "$PROJECTS_ONLY" = 1 ]; then scan_projects "$SCAN_ROOT"; exit 0; fi

head1 "declutter $DECLUTTER_VERSION — $PLATFORM — $(human "$(free_kb)") $T_FREE_ON"
say "${DIM}${T_SCANNING}${R}"
register_all
build_order

if [ "${#ORDER[@]}" -eq 0 ]; then
  if [ "$JSON" = 1 ]; then print_json; else say "$T_NOTHING"; fi
  exit 0
fi

# With --level green the yellow tier stays unticked (build_order already did
# that); with --level yellow, pre-tick yellow as well.
if [ "$LEVEL" = yellow ]; then
  for ((_i=0; _i<${#ORDER[@]}; _i++)); do
    [ "${I_LEVEL[${ORDER[$_i]}]}" = red ] || SEL[$_i]=1
  done
fi

if [ "$JSON" = 1 ]; then
  print_json
  exit 0
fi

if [ "$INTERACTIVE" = no ]; then
  print_plain_list
  exit 0
fi

if [ "$ASSUME_YES" = 1 ]; then
  print_plain_list
  run_selection
  exit 0
fi

if [ ! -t 0 ] || [ ! -t 1 ]; then
  print_plain_list
  say ""
  say "  ${DIM}${T_NOT_TTY}${R}"
  exit 0
fi

if pick_interactive; then
  run_selection
else
  say "$T_EXITED"
fi
